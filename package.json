{
	"name": "medops-quality-tooling",
	"version": "0.1.0",
	"private": true,
	"description": "Pinned frontend lint, format and Python type-check tooling for medops",
	"engines": {
		"node": ">=20.19.0"
	},
	"packageManager": "npm@11.17.0",
	"scripts": {
		"typecheck": "pyright --project pyrightconfig.json",
		"test:frontend": "node --test scripts/tests/*.test.mjs",
		"lint:frontend": "eslint . --max-warnings 0",
		"format:frontend:check": "prettier --check \"medops/**/*.{js,ts,vue,css,scss,json}\" \".prettierrc.json\" \"eslint.config.mjs\" \"package.json\" \"package-lock.json\" \"pyrightconfig.json\" \"scripts/tests/*.test.mjs\"",
		"format:frontend": "prettier --write \"medops/**/*.{js,ts,vue,css,scss,json}\" \".prettierrc.json\" \"eslint.config.mjs\" \"package.json\" \"package-lock.json\" \"pyrightconfig.json\" \"scripts/tests/*.test.mjs\"",
		"quality:node": "npm run typecheck && npm run lint:frontend && npm run test:frontend && npm run format:frontend:check",
		"quality": "python scripts/quality.py"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-vue": "10.10.0",
		"globals": "17.8.0",
		"prettier": "3.9.6",
		"pyright": "1.1.411",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0"
	}
}
