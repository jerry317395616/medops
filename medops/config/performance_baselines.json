{
	"schema_version": 1,
	"app": "medops",
	"policy": {
		"allowed_profiles": ["development", "test"],
		"managed_environment_required": true,
		"allow_tests_required": true,
		"synthetic_data_only_required": true,
		"public_access_forbidden": true,
		"external_integrations_forbidden": true,
		"http_write_enabled": false,
		"k6_version": "2.1.0",
		"max_virtual_users": 50,
		"max_iterations": 5000,
		"max_duration_seconds": 300
	},
	"scenarios": [
		{
			"scenario_id": "platform-module-registry-read",
			"version": 1,
			"label": "平台模块注册表只读基线",
			"description": "验证认证、权限、数据库查询和 JSON 序列化的端到端只读性能。",
			"method": "GET",
			"path": "/api/method/medops.api.v1.modules.list_modules",
			"response_contract": "module_registry_v1",
			"required_roles": ["System Manager", "HRP System Manager"],
			"contains_personal_data": false,
			"read_only": true,
			"profiles": [
				{
					"profile": "smoke",
					"virtual_users": 1,
					"iterations": 5,
					"max_duration_seconds": 15,
					"thresholds": {
						"max_error_rate": 0,
						"min_check_rate": 1,
						"p95_ms": 1000,
						"p99_ms": 1500,
						"min_requests_per_second": 0.2
					}
				},
				{
					"profile": "baseline",
					"virtual_users": 10,
					"iterations": 200,
					"max_duration_seconds": 60,
					"thresholds": {
						"max_error_rate": 0.01,
						"min_check_rate": 0.99,
						"p95_ms": 750,
						"p99_ms": 1500,
						"min_requests_per_second": 3
					}
				},
				{
					"profile": "load",
					"virtual_users": 25,
					"iterations": 1000,
					"max_duration_seconds": 180,
					"thresholds": {
						"max_error_rate": 0.01,
						"min_check_rate": 0.99,
						"p95_ms": 1000,
						"p99_ms": 2000,
						"min_requests_per_second": 5
					}
				}
			]
		}
	]
}
