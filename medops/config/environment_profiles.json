{
	"schema_version": 1,
	"required_apps": ["frappe", "erpnext", "hrms", "medops"],
	"profiles": {
		"development": {
			"label": "Development",
			"bench_dir": "~/.local/share/medops/environments/development/frappe-bench",
			"site_name": "hrp-dev.localhost",
			"developer_mode": true,
			"allow_tests": true,
			"scheduler_enabled": true,
			"external_integrations_enabled": false,
			"email_queue_enabled": false,
			"synthetic_data_only": true,
			"public_access": false,
			"reset_policy": "replaceable",
			"ports": {
				"redis_cache": 13100,
				"redis_queue": 11100,
				"socketio": 9100,
				"webserver": 8100,
				"file_watcher": 6810
			}
		},
