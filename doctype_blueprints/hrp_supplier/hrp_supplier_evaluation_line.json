{
  "doctype": "DocType",
  "name": "HRP Supplier Evaluation Line",
  "module": "HRP Supplier",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "",
  "title_field": "",
  "is_submittable": 0,
  "istable": 1,
  "issingle": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "editable_grid": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "description": "供应商领域的HRP供应商评价明细对象；用于支撑业务闭环、权限、审计与对账。",
  "fields": [
    {
      "fieldname": "sequence_no",
      "label": "序号",
      "fieldtype": "Int",
      "default": "1",
      "in_list_view": 1,
      "description": "序号"
    },
    {
      "fieldname": "reference_doctype",
      "label": "引用类型",
      "fieldtype": "Link",
      "options": "DocType",
      "description": "引用类型"
    },
    {
      "fieldname": "reference_name",
      "label": "引用单据",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "search_index": 1,
      "description": "引用单据"
    },
    {
      "fieldname": "description",
      "label": "说明",
      "fieldtype": "Small Text",
      "description": "说明"
    },
    {
      "fieldname": "quantity",
      "label": "数量",
      "fieldtype": "Float",
      "precision": "6",
      "description": "数量"
    },
    {
      "fieldname": "rate",
      "label": "单价",
      "fieldtype": "Currency",
      "options": "currency",
      "precision": "6",
      "description": "单价"
    },
    {
      "fieldname": "amount",
      "label": "金额",
      "fieldtype": "Currency",
      "options": "currency",
      "read_only": 1,
      "in_list_view": 1,
      "precision": "2",
      "description": "金额"
    },
    {
      "fieldname": "dimension_json",
      "label": "核算维度",
      "fieldtype": "Code",
      "options": "JSON",
      "description": "核算维度"
    },
    {
      "fieldname": "supplier",
      "label": "ERPNext供应商",
      "fieldtype": "Link",
      "options": "Supplier",
      "search_index": 1,
      "description": "ERPNext供应商"
    },
    {
      "fieldname": "unified_credit_code",
      "label": "统一社会信用代码",
      "fieldtype": "Data",
      "search_index": 1,
      "description": "统一社会信用代码"
    },
    {
      "fieldname": "supplier_type",
      "label": "供应商类型",
      "fieldtype": "Select",
      "options": "Manufacturer\nDistributor\nService\nConstruction\nOther",
      "description": "供应商类型"
    },
    {
      "fieldname": "risk_level",
      "label": "风险等级",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nCritical",
      "search_index": 1,
      "description": "风险等级"
    },
    {
      "fieldname": "grade",
      "label": "等级",
      "fieldtype": "Link",
      "options": "HRP Supplier Grade",
      "description": "等级"
    },
    {
      "fieldname": "certificate_expiry",
      "label": "最早证照到期日",
      "fieldtype": "Date",
      "search_index": 1,
      "description": "最早证照到期日"
    }
  ],
  "permissions": [
    {
      "role": "HRP Procurement User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HRP Supply Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 10,
    "data_classification": "内部",
    "key_indexes": [
      "company",
      "organization_unit"
    ],
    "standard_references": [
      "Supplier"
    ],
    "domain_group": "Supply",
    "module_package": "hrp_supplier"
  }
}
