{
  "doctype": "DocType",
  "name": "HRP Contract Line",
  "module": "HRP Contract",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "",
  "title_field": "",
  "is_submittable": 0,
  "istable": 1,
  "issingle": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "editable_grid": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "description": "合同领域的HRP合同明细对象；用于支撑业务闭环、权限、审计与对账。",
  "fields": [
    {
      "fieldname": "sequence_no",
      "label": "序号",
      "fieldtype": "Int",
      "default": "1",
      "in_list_view": 1,
      "description": "序号"
    },
    {
      "fieldname": "reference_doctype",
      "label": "引用类型",
      "fieldtype": "Link",
      "options": "DocType",
      "description": "引用类型"
    },
    {
      "fieldname": "reference_name",
      "label": "引用单据",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "search_index": 1,
      "description": "引用单据"
    },
    {
      "fieldname": "description",
      "label": "说明",
      "fieldtype": "Small Text",
      "description": "说明"
    },
    {
      "fieldname": "quantity",
      "label": "数量",
      "fieldtype": "Float",
      "precision": "6",
      "description": "数量"
    },
    {
      "fieldname": "rate",
      "label": "单价",
      "fieldtype": "Currency",
      "options": "currency",
      "precision": "6",
      "description": "单价"
    },
    {
      "fieldname": "amount",
      "label": "金额",
      "fieldtype": "Currency",
      "options": "currency",
      "read_only": 1,
      "in_list_view": 1,
      "precision": "2",
      "description": "金额"
    },
    {
      "fieldname": "dimension_json",
      "label": "核算维度",
      "fieldtype": "Code",
      "options": "JSON",
      "description": "核算维度"
    },
    {
      "fieldname": "contract_type",
      "label": "合同类型",
      "fieldtype": "Select",
      "options": "Purchase\nService\nConstruction\nLease\nResearch\nOther",
      "search_index": 1,
      "description": "合同类型"
    },
    {
      "fieldname": "counterparty",
      "label": "合同相对方",
      "fieldtype": "Link",
      "options": "HRP Contract Counterparty",
      "search_index": 1,
      "description": "合同相对方"
    },
    {
      "fieldname": "contract_amount",
      "label": "合同金额",
      "fieldtype": "Currency",
      "options": "currency",
      "in_list_view": 1,
      "precision": "2",
      "description": "合同金额"
    },
    {
      "fieldname": "tax_amount",
      "label": "税额",
      "fieldtype": "Currency",
      "options": "currency",
      "precision": "2",
      "description": "税额"
    },
    {
      "fieldname": "start_date",
      "label": "开始日期",
      "fieldtype": "Date",
      "search_index": 1,
      "description": "开始日期"
    },
    {
      "fieldname": "end_date",
      "label": "结束日期",
      "fieldtype": "Date",
      "search_index": 1,
      "description": "结束日期"
    },
    {
      "fieldname": "signed_date",
      "label": "签署日期",
      "fieldtype": "Date",
      "description": "签署日期"
    },
    {
      "fieldname": "budget_commitment",
      "label": "预算承诺",
      "fieldtype": "Link",
      "options": "HRP Budget Commitment",
      "description": "预算承诺"
    },
    {
      "fieldname": "payment_progress",
      "label": "付款进度",
      "fieldtype": "Percent",
      "read_only": 1,
      "description": "付款进度"
    },
    {
      "fieldname": "performance_status",
      "label": "履约状态",
      "fieldtype": "Select",
      "options": "Not Started\nIn Progress\nAt Risk\nCompleted\nTerminated",
      "description": "履约状态"
    }
  ],
  "permissions": [
    {
      "role": "HRP Procurement User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HRP Supply Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 30,
    "data_classification": "内部",
    "key_indexes": [
      "company",
      "organization_unit"
    ],
    "standard_references": [],
    "domain_group": "Supply",
    "module_package": "hrp_contract"
  }
}
