{
  "doctype": "DocType",
  "name": "HRP Contract Alert",
  "module": "HRP Contract",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:SUP-.YYYY.-.#####",
  "title_field": "subject",
  "is_submittable": 0,
  "istable": 0,
  "issingle": 0,
  "track_changes": 0,
  "allow_rename": 0,
  "editable_grid": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "description": "合同领域的HRP合同预警对象；用于支撑业务闭环、权限、审计与对账。",
  "fields": [
    {
      "fieldname": "event_time",
      "label": "发生时间",
      "fieldtype": "Datetime",
      "reqd": 1,
      "search_index": 1,
      "in_list_view": 1,
      "description": "发生时间"
    },
    {
      "fieldname": "status",
      "label": "状态",
      "fieldtype": "Select",
      "options": "Pending\nProcessing\nSuccess\nFailed\nIgnored",
      "reqd": 1,
      "search_index": 1,
      "in_list_view": 1,
      "description": "状态"
    },
    {
      "fieldname": "correlation_id",
      "label": "关联ID",
      "fieldtype": "Data",
      "search_index": 1,
      "in_list_view": 1,
      "description": "关联ID"
    },
    {
      "fieldname": "idempotency_key",
      "label": "幂等键",
      "fieldtype": "Data",
      "search_index": 1,
      "description": "幂等键"
    },
    {
      "fieldname": "reference_doctype",
      "label": "引用类型",
      "fieldtype": "Link",
      "options": "DocType",
      "description": "引用类型"
    },
    {
      "fieldname": "reference_name",
      "label": "引用单据",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "search_index": 1,
      "description": "引用单据"
    },
    {
      "fieldname": "payload_hash",
      "label": "报文哈希",
      "fieldtype": "Data",
      "description": "报文哈希"
    },
    {
      "fieldname": "payload",
      "label": "报文",
      "fieldtype": "Long Text",
      "description": "报文"
    },
    {
      "fieldname": "error_code",
      "label": "错误码",
      "fieldtype": "Data",
      "description": "错误码"
    },
    {
      "fieldname": "error_message",
      "label": "错误信息",
      "fieldtype": "Long Text",
      "description": "错误信息"
    },
    {
      "fieldname": "retry_count",
      "label": "重试次数",
      "fieldtype": "Int",
      "default": "0",
      "description": "重试次数"
    },
    {
      "fieldname": "next_retry_at",
      "label": "下次重试",
      "fieldtype": "Datetime",
      "description": "下次重试"
    },
    {
      "fieldname": "contract_type",
      "label": "合同类型",
      "fieldtype": "Select",
      "options": "Purchase\nService\nConstruction\nLease\nResearch\nOther",
      "search_index": 1,
      "description": "合同类型"
    },
    {
      "fieldname": "counterparty",
      "label": "合同相对方",
      "fieldtype": "Link",
      "options": "HRP Contract Counterparty",
      "search_index": 1,
      "description": "合同相对方"
    },
    {
      "fieldname": "contract_amount",
      "label": "合同金额",
      "fieldtype": "Currency",
      "options": "currency",
      "in_list_view": 1,
      "precision": "2",
      "description": "合同金额"
    },
    {
      "fieldname": "tax_amount",
      "label": "税额",
      "fieldtype": "Currency",
      "options": "currency",
      "precision": "2",
      "description": "税额"
    },
    {
      "fieldname": "start_date",
      "label": "开始日期",
      "fieldtype": "Date",
      "search_index": 1,
      "description": "开始日期"
    },
    {
      "fieldname": "end_date",
      "label": "结束日期",
      "fieldtype": "Date",
      "search_index": 1,
      "description": "结束日期"
    },
    {
      "fieldname": "signed_date",
      "label": "签署日期",
      "fieldtype": "Date",
      "description": "签署日期"
    },
    {
      "fieldname": "budget_commitment",
      "label": "预算承诺",
      "fieldtype": "Link",
      "options": "HRP Budget Commitment",
      "description": "预算承诺"
    },
    {
      "fieldname": "payment_progress",
      "label": "付款进度",
      "fieldtype": "Percent",
      "read_only": 1,
      "description": "付款进度"
    },
    {
      "fieldname": "performance_status",
      "label": "履约状态",
      "fieldtype": "Select",
      "options": "Not Started\nIn Progress\nAt Risk\nCompleted\nTerminated",
      "description": "履约状态"
    }
  ],
  "permissions": [
    {
      "role": "HRP Procurement User",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HRP Supply Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 30,
    "data_classification": "内部",
    "key_indexes": [
      "company",
      "organization_unit",
      "status",
      "posting_date"
    ],
    "standard_references": [],
    "domain_group": "Supply",
    "module_package": "hrp_contract"
  }
}
