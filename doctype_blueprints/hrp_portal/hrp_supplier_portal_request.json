{
  "doctype": "DocType",
  "name": "HRP Supplier Portal Request",
  "module": "HRP Portal",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "format:POR-.YYYY.-.#####",
  "title_field": "subject",
  "is_submittable": 1,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "editable_grid": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "description": "门户领域的HRP供应商门户申请对象；用于支撑业务闭环、权限、审计与对账。",
  "fields": [
    {
      "fieldname": "company",
      "label": "法人",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "search_index": 1,
      "in_list_view": 1,
      "description": "法人"
    },
    {
      "fieldname": "hospital",
      "label": "医院",
      "fieldtype": "Link",
      "options": "HRP Hospital",
      "reqd": 1,
      "search_index": 1,
      "description": "医院"
    },
    {
      "fieldname": "campus",
      "label": "院区",
      "fieldtype": "Link",
      "options": "HRP Campus",
      "search_index": 1,
      "description": "院区"
    },
    {
      "fieldname": "organization_unit",
      "label": "组织单元",
      "fieldtype": "Link",
      "options": "HRP Organization Unit",
      "reqd": 1,
      "search_index": 1,
      "in_list_view": 1,
      "description": "组织单元"
    },
    {
      "fieldname": "cost_center",
      "label": "成本中心",
      "fieldtype": "Link",
      "options": "Cost Center",
      "search_index": 1,
      "description": "成本中心"
    },
    {
      "fieldname": "fiscal_year",
      "label": "财政年度",
      "fieldtype": "Link",
      "options": "Fiscal Year",
      "search_index": 1,
      "description": "财政年度"
    },
    {
      "fieldname": "currency",
      "label": "币种",
      "fieldtype": "Link",
      "options": "Currency",
      "default": "CNY",
      "description": "币种"
    },
    {
      "fieldname": "status",
      "label": "业务状态",
      "fieldtype": "Select",
      "options": "Draft\nUnder Review\nApproved\nRejected\nIn Progress\nCompleted\nCancelled\nClosed",
      "default": "Draft",
      "search_index": 1,
      "in_list_view": 1,
      "description": "业务状态"
    },
    {
      "fieldname": "workflow_state",
      "label": "工作流状态",
      "fieldtype": "Link",
      "options": "Workflow State",
      "search_index": 1,
      "read_only": 1,
      "description": "工作流状态"
    },
    {
      "fieldname": "posting_date",
      "label": "业务日期",
      "fieldtype": "Date",
      "reqd": 1,
      "search_index": 1,
      "in_list_view": 1,
      "description": "业务日期"
    },
    {
      "fieldname": "applicant",
      "label": "申请人",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "search_index": 1,
      "description": "申请人"
    },
    {
      "fieldname": "employee",
      "label": "员工",
      "fieldtype": "Link",
      "options": "Employee",
      "search_index": 1,
      "description": "员工"
    },
    {
      "fieldname": "subject",
      "label": "主题",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "description": "主题"
    },
    {
      "fieldname": "total_amount",
      "label": "总金额",
      "fieldtype": "Currency",
      "options": "currency",
      "in_list_view": 1,
      "precision": "2",
      "description": "总金额"
    },
    {
      "fieldname": "external_id",
      "label": "外部ID",
      "fieldtype": "Data",
      "search_index": 1,
      "description": "外部ID"
    },
    {
      "fieldname": "source_doctype",
      "label": "来源类型",
      "fieldtype": "Link",
      "options": "DocType",
      "description": "来源类型"
    },
    {
      "fieldname": "source_name",
      "label": "来源单据",
      "fieldtype": "Dynamic Link",
      "options": "source_doctype",
      "search_index": 1,
      "description": "来源单据"
    },
    {
      "fieldname": "submitted_at",
      "label": "提交时间",
      "fieldtype": "Datetime",
      "read_only": 1,
      "description": "提交时间"
    },
    {
      "fieldname": "approved_at",
      "label": "批准时间",
      "fieldtype": "Datetime",
      "read_only": 1,
      "description": "批准时间"
    },
    {
      "fieldname": "remarks",
      "label": "备注",
      "fieldtype": "Small Text",
      "description": "备注"
    },
    {
      "fieldname": "supplier",
      "label": "ERPNext供应商",
      "fieldtype": "Link",
      "options": "Supplier",
      "search_index": 1,
      "description": "ERPNext供应商"
    },
    {
      "fieldname": "unified_credit_code",
      "label": "统一社会信用代码",
      "fieldtype": "Data",
      "search_index": 1,
      "description": "统一社会信用代码"
    },
    {
      "fieldname": "supplier_type",
      "label": "供应商类型",
      "fieldtype": "Select",
      "options": "Manufacturer\nDistributor\nService\nConstruction\nOther",
      "description": "供应商类型"
    },
    {
      "fieldname": "risk_level",
      "label": "风险等级",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nCritical",
      "search_index": 1,
      "description": "风险等级"
    },
    {
      "fieldname": "grade",
      "label": "等级",
      "fieldtype": "Link",
      "options": "HRP Supplier Grade",
      "description": "等级"
    },
    {
      "fieldname": "certificate_expiry",
      "label": "最早证照到期日",
      "fieldtype": "Date",
      "search_index": 1,
      "description": "最早证照到期日"
    }
  ],
  "permissions": [
    {
      "role": "HRP Portal User",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 1,
      "cancel": 1,
      "amend": 0
    },
    {
      "role": "HRP Portal Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 1,
      "cancel": 1,
      "amend": 0
    }
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 10,
    "data_classification": "内部",
    "key_indexes": [
      "company",
      "organization_unit",
      "status",
      "posting_date"
    ],
    "standard_references": [
      "Supplier"
    ],
    "domain_group": "Portal",
    "module_package": "hrp_portal"
  }
}
