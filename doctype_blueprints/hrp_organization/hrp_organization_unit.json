    {
      "fieldname": "valid_from",
      "fieldtype": "Date",
      "label": "有效期开始",
      "read_only": 1
    },
    {
      "fieldname": "valid_to",
      "fieldtype": "Date",
      "label": "有效期结束",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "备注",
      "read_only": 1
    },
    {
      "fieldname": "lft",
      "fieldtype": "Int",
      "hidden": 1,
      "label": "左边界",
      "read_only": 1
    },
    {
      "fieldname": "rgt",
      "fieldtype": "Int",
      "hidden": 1,
      "label": "右边界",
      "read_only": 1
    },
    {
      "fieldname": "old_parent",
      "fieldtype": "Data",
      "hidden": 1,
      "label": "原上级",
      "read_only": 1
    }
