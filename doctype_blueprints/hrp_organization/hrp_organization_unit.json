      "options": "Company",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
      "fieldname": "hospital",
      "fieldtype": "Link",
      "label": "医院",
      "options": "HRP Hospital",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
