{
  "doctype": "DocType",
  "name": "HRP Organization Version",
  "module": "HRP Organization",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "Prompt",
  "title_field": "version_label",
  "is_submittable": 1,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "editable_grid": 0,
  "sort_field": "effective_from",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "description": "医院组织层级的有效日期版本；发布后不可修改或取消。",
  "fields": [
    {
      "fieldname": "hospital",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "医院",
      "options": "HRP Hospital",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "所属法人",
      "options": "Company",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
      "fieldname": "version_number",
      "fieldtype": "Int",
      "label": "版本序号",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
      "fieldname": "version_code",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "版本编码",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
      "fieldname": "version_label",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "版本名称",
      "reqd": 1
    },
    {
      "fieldname": "effective_from",
      "fieldtype": "Date",
      "in_list_view": 1,
      "label": "生效日期",
      "reqd": 1,
      "search_index": 1
    },
    {
      "default": "Draft",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "版本状态",
      "options": "Draft\nPublished",
      "read_only": 1,
      "reqd": 1,
      "search_index": 1
    },
    {
      "default": "0",
      "fieldname": "node_count",
      "fieldtype": "Int",
      "label": "组织单元数",
      "read_only": 1,
      "reqd": 1
    },
    {
      "fieldname": "hierarchy_digest",
      "fieldtype": "Data",
      "label": "层级摘要",
      "read_only": 1,
      "reqd": 1
    },
    {
      "default": "1",
      "fieldname": "revision",
      "fieldtype": "Int",
      "label": "修订号",
      "read_only": 1,
      "reqd": 1
    },
    {
      "fieldname": "published_at",
      "fieldtype": "Datetime",
      "label": "发布时间",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "备注"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HRP System Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HRP Data Steward",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 10,
    "data_classification": "内部",
    "key_indexes": [
      "hospital",
      "company",
      "effective_from",
      "status"
    ],
    "standard_references": [
      "Company"
    ],
    "domain_group": "Core",
    "module_package": "hrp_organization"
  }
}
