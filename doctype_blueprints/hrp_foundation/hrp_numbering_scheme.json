{
  "doctype": "DocType",
  "name": "HRP Numbering Scheme",
  "module": "HRP Foundation",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "field:code",
  "title_field": "display_name",
  "is_submittable": 0,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "editable_grid": 0,
  "sort_field": "code",
  "sort_order": "ASC",
  "index_web_pages_for_search": 0,
  "description": "受控业务编号方案；只允许通过统一编号服务维护。",
  "fields": [
    {"fieldname": "code", "label": "方案编码", "fieldtype": "Data", "reqd": 1, "unique": 1, "search_index": 1, "in_list_view": 1},
    {"fieldname": "display_name", "label": "方案名称", "fieldtype": "Data", "reqd": 1, "search_index": 1, "in_list_view": 1},
    {"fieldname": "company", "label": "法人", "fieldtype": "Link", "options": "Company", "reqd": 1, "search_index": 1, "in_list_view": 1},
    {"fieldname": "hospital", "label": "医院", "fieldtype": "Link", "options": "HRP Hospital", "reqd": 1, "search_index": 1, "in_list_view": 1},
    {"fieldname": "organization_unit", "label": "组织单元", "fieldtype": "Link", "options": "HRP Organization Unit", "search_index": 1},
    {"fieldname": "enabled", "label": "启用", "fieldtype": "Check", "default": "1", "search_index": 1, "in_list_view": 1},
    {"fieldname": "template", "label": "编号模板", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "dimension_keys", "label": "维度键", "fieldtype": "Code", "options": "JSON", "reqd": 1, "read_only": 1, "hidden": 1},
    {"fieldname": "reset_policy", "label": "重置周期", "fieldtype": "Select", "options": "Never\nYearly\nMonthly\nDaily", "default": "Never", "reqd": 1, "in_list_view": 1},
    {"fieldname": "sequence_digits", "label": "流水号位数", "fieldtype": "Int", "default": "6", "reqd": 1},
    {"fieldname": "start_number", "label": "起始序号", "fieldtype": "Int", "default": "1", "reqd": 1},
    {"fieldname": "template_digest", "label": "模板摘要", "fieldtype": "Data", "reqd": 1, "read_only": 1, "hidden": 1, "no_copy": 1},
    {"fieldname": "revision", "label": "修订号", "fieldtype": "Int", "reqd": 1, "read_only": 1, "no_copy": 1},
    {"fieldname": "valid_from", "label": "有效期开始", "fieldtype": "Date"},
    {"fieldname": "valid_to", "label": "有效期结束", "fieldtype": "Date"},
    {"fieldname": "remarks", "label": "说明", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0},
    {"role": "HRP System Manager", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0},
    {"role": "HRP User", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0},
    {"role": "HRP Auditor", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0},
    {"role": "HRP Integration User", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0}
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 30,
    "data_classification": "内部",
    "key_indexes": ["code", "company", "hospital", "enabled", "valid_from", "valid_to"],
    "standard_references": ["Company"],
    "domain_group": "Core",
    "module_package": "hrp_foundation"
  }
}
