{
  "doctype": "DocType",
  "name": "HRP System Settings",
  "module": "HRP Foundation",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "",
  "title_field": "",
  "is_submittable": 0,
  "istable": 0,
  "issingle": 1,
  "track_changes": 1,
  "allow_rename": 0,
  "editable_grid": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "index_web_pages_for_search": 0,
  "description": "HRP全局安全与集成默认值；固定策略只能随受控代码发布变更。",
  "fields": [
    {
      "fieldname": "enabled",
      "label": "启用",
      "fieldtype": "Check",
      "default": "1",
      "description": "启用"
    },
    {
      "fieldname": "release_channel",
      "label": "发布通道",
      "fieldtype": "Data",
      "default": "locked-develop",
      "read_only": 1,
      "description": "由锁定上游基线决定，不允许在站点内修改"
    },
    {
      "fieldname": "configuration_version",
      "label": "配置版本",
      "fieldtype": "Int",
      "default": "1",
      "read_only": 1,
      "description": "用于防止并发覆盖的单调版本"
    },
    {
      "fieldname": "default_company",
      "label": "默认法人",
      "fieldtype": "Link",
      "options": "Company",
      "description": "默认法人"
    },
    {
      "fieldname": "default_hospital",
      "label": "默认医院",
      "fieldtype": "Link",
      "description": "默认医院；必须属于默认法人",
      "options": "HRP Hospital"
    },
    {
      "fieldname": "strict_data_scope",
      "label": "严格数据域",
      "fieldtype": "Check",
      "default": "1",
      "read_only": 1,
      "description": "固定启用，禁止在站点内弱化"
    },
    {
      "fieldname": "require_human_confirmation_for_ai",
      "label": "AI 操作需要人工确认",
      "fieldtype": "Check",
      "default": "1",
      "read_only": 1,
      "description": "固定启用，禁止在站点内弱化"
    },
    {
      "fieldname": "integration_timeout_seconds",
      "label": "集成超时（秒）",
      "fieldtype": "Int",
      "default": "30",
      "description": "允许5至300秒"
    },
    {
      "fieldname": "remarks",
      "label": "说明",
      "fieldtype": "Small Text",
      "description": "说明"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    },
    {
      "role": "HRP System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "links": [],
  "actions": [],
  "x_hrp": {
    "app": "medops",
    "retention_years": 10,
    "data_classification": "内部",
    "key_indexes": [],
    "standard_references": [],
    "domain_group": "Core",
    "module_package": "hrp_foundation"
  }
}
